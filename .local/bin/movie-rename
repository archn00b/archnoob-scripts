#!/usr/bin/env bash

find . -type f -iname "*.mp4" -print0 |
while IFS= read -r -d '' file; do

    # Get filename without extension
    name="${file%.mp4}"

    # Match Movie.Name.YEAR and remove everything after the year
    if [[ "$name" =~ ^(.*\.[0-9]{4})(\..*)?$ ]]; then
        new_name="${BASH_REMATCH[1]}.mp4"

        # Full path for the renamed file
        new_file="$(dirname "$file")/$new_name"

        # Skip if already correctly named
        if [[ "$file" == "$new_file" ]]; then
            continue
        fi

        echo "Renaming:"
        echo "  $file"
        echo "  -> $new_file"

        mv -- "$file" "$new_file"
    fi

done
