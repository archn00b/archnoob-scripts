#!/bin/bash

for dir in */; do
    name="${dir%/}"

    # Match Movie Name (YEAR) and remove everything after it
    if [[ "$name" =~ ^(.*\([0-9]{4}\)).*$ ]]; then
        new_name="${BASH_REMATCH[1]}"

        # Skip if already correctly named
        if [[ "$name" == "$new_name" ]]; then
            continue
        fi

        echo "$name"
        echo "  -> $new_name"

        mv -- "$name" "$new_name"
    fi
done